{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"D:/meetingnote-pro/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"D:/meetingnote-pro/.claude/hooks/prompt-mark.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"D:/meetingnote-pro/.claude/hooks/pre-tool.sh\""
          }
        ],
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ". \"D:/meetingnote-pro/.claude/hooks/check-todo.sh\""
          }
        ]
      }
    ]
  }
}
